<!--
  SOC Home Lab - custom Wazuh detection rules
  Range: 100100-100199
  Location on manager: /var/ossec/etc/rules/soc_lab_rules.xml
-->
<group name="soc_lab,windows,">

  <!-- PowerShell launched with an encoded command -->
  <rule id="100101" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-(e|ec|enc|enco|encod|encode|encodedcommand)\s</field>
    <description>SOC-LAB: PowerShell executed with an encoded command on $(win.system.computer)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
  </rule>

  <!-- Script block with download / decode / dynamic execution keywords -->
  <rule id="100102" level="8">
    <if_sid>91802</if_sid>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(Net\.WebClient|DownloadString|DownloadFile|Invoke-WebRequest|Start-BitsTransfer|Invoke-Expression|\biex\b|FromBase64String)</field>
    <description>SOC-LAB: Suspicious PowerShell script block (download/decode/execute keywords)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- Registry Run / RunOnce persistence -->
  <rule id="100103" level="10">
    <if_group>sysmon_event_13</if_group>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\Software\\Microsoft\\Windows\\CurrentVersion\\(Run|RunOnce)\\</field>
    <description>SOC-LAB: Registry Run key value set by $(win.eventdata.image)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <!-- Scheduled task created from the command line -->
  <rule id="100104" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create</field>
    <description>SOC-LAB: Scheduled task created via schtasks.exe by $(win.eventdata.user)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- Executable launched from a user-writable location -->
  <rule id="100105" level="7">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(Users\\Public|AppData\\Local\\Temp|Windows\\Temp|Downloads)\\[^\\]+\.exe$</field>
    <description>SOC-LAB: Executable launched from user-writable path: $(win.eventdata.image)</description>
  </rule>

  <!-- Single discovery command (low severity, feeds 100107) -->
  <rule id="100106" level="4">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(whoami|systeminfo|ipconfig|net|net1|nltest|quser|tasklist)\.exe$</field>
    <description>SOC-LAB: Discovery command executed: $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1033</id>
      <id>T1082</id>
    </mitre>
  </rule>

  <!-- Correlation: burst of discovery commands on one host -->
  <rule id="100107" level="10" frequency="4" timeframe="120">
    <if_matched_sid>100106</if_matched_sid>
    <same_field>win.system.computer</same_field>
    <description>SOC-LAB: Burst of discovery commands on $(win.system.computer) - possible hands-on-keyboard reconnaissance</description>
    <mitre>
      <id>T1033</id>
      <id>T1082</id>
    </mitre>
  </rule>

</group>
